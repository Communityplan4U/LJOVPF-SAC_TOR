# Configure these only on the server (Vercel -> Project Settings -> Environment Variables).
# Use a NEW, dedicated Supabase project; the database key stays ONLY in Supabase.
SUPABASE_URL=https://rwrvsuheybpqelbtjaha.supabase.co
# Separate opaque, randomly generated 64-128 character tokens for the Edge gateway.
SURVEY_GATEWAY_TOKEN=REPLACE_WITH_A_64_CHARACTER_RANDOM_BASE64URL_TOKEN
SURVEY_GATEWAY_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_RANDOM_BASE64URL_TOKEN
# Configure in Supabase Edge Function secrets, NOT Vercel:
# SAC_GATEWAY_TOKEN_SHA256=<sha256 hex digest of SURVEY_GATEWAY_TOKEN>
# SAC_GATEWAY_ADMIN_TOKEN_SHA256=<sha256 hex digest of SURVEY_GATEWAY_ADMIN_TOKEN>
# SUPABASE_SECRET_KEYS (or Supabase-managed SUPABASE_SERVICE_ROLE_KEY) stays in Supabase.
# At least 32 random characters. Only authorized administrators should know this.
ADMIN_EXPORT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required when /ljovsac is reverse-proxied from the main website to a separate Vercel app.
PUBLIC_ORIGINS=https://communityinpublic.ca,https://www.communityinpublic.ca

# Optional Resend transactional return-link email (disabled until intentionally enabled).
RESEND_API_KEY=YOUR_RESEND_SECRET
RESEND_FROM=Connect@CPplanning.ca
RESEND_REPLY_TO=Connect@CPplanning.ca
PUBLIC_URL=https://communityinpublic.ca/ljovsac
RETURN_LINK_EMAIL_ENABLED=false
