{
  "schema_version": "tor12-v1",
  "assessment_status": "awaiting_approval",
  "published": false,
  "assessment_scope": "Explicit provisions of each written Terms of Reference only",
  "reference_id": "ljovpf",
  "areas": [
    {
      "id": "G1",
      "name": "Community decision-making and influence",
      "rank": 1,
      "weight": 30
    },
    {
      "id": "G2",
      "name": "Timing and meaningful participation",
      "rank": 2,
      "weight": 25
    },
    {
      "id": "G3",
      "name": "Representation, equity and support",
      "rank": 3,
      "weight": 20
    },
    {
      "id": "G5",
      "name": "Transparency and public accountability",
      "rank": 4,
      "weight": 15
    },
    {
      "id": "G4",
      "name": "Committee governance and responsibilities",
      "rank": 5,
      "weight": 10
    }
  ],
  "components": [
    {
      "id": "G1-01",
      "area": "G1",
      "name": "Members' ability to shape the agenda and planning work",
      "description": "Assess whether the TOR expressly enables members to propose agenda items, identify planning priorities, advise on study scope or engagement methods, and shape directions or options. Distinguish a defined right to initiate or jointly set these matters from an invitation to comment on staff-selected topics or prepared drafts. Judge only the roles and processes stated in the TOR, not whether members exercised those powers."
    },
    {
      "id": "G1-02",
      "area": "G1",
      "name": "Collective recommendations and the stated use of advice",
      "description": "Assess whether the TOR permits members to deliberate, seek consensus, issue collective recommendations, and preserve differing views. Examine what the TOR explicitly requires staff to do with those recommendations when developing the plan or its final advice. Distinguish a stated commitment to incorporate advice where feasible from a promise merely to receive or consider feedback. Does not judge whether advice was subsequently accepted or acted upon."
    },
    {
      "id": "G2-01",
      "area": "G2",
      "name": "Participation stages, committee term and meetings",
      "description": "Assess which planning phases the TOR assigns to the committee, the specified meeting frequency and duration, its term, and provisions for additional meetings or working groups. Distinguish involvement in vision, options and implementation stages from review of a nearly complete draft."
    },
    {
      "id": "G2-02",
      "area": "G2",
      "name": "Advance information and community communication",
      "description": "Assess whether the TOR specifies advance notice and access to agendas, draft materials and discussion questions. Examine any formal role for members in gathering views from their communities, sharing information back, or using City-provided outreach resources."
    },
    {
      "id": "G3-01",
      "area": "G3",
      "name": "Representative membership, selection and continuity",
      "description": "Assess whether the TOR specifies a membership size or range, groups and interests to be represented, recruitment and selection procedures, alternate arrangements, and how vacancies or representation gaps are addressed. Consider whether those provisions identify people most affected by the planning subject, including equity-deserving communities where relevant."
    },
    {
      "id": "G3-02",
      "area": "G3",
      "name": "Compensation, accessibility and access to expertise",
      "description": "Assess the TOR's explicit provisions for honoraria or expense coverage, accessible meeting arrangements, interpretation or alternative formats, written or remote participation, orientation, and access to technical or interdivisional expertise. Check any specified eligibility, request process or responsible staff role. Distinguish concrete supports from general commitments to inclusion. Do not infer whether compensation, accommodations or expert assistance were actually delivered."
    },
    {
      "id": "G5-01",
      "area": "G5",
      "name": "Meeting records and member review",
      "description": "Assess what records the TOR commits to or permits (for example, minutes, summaries, recommendations, dissent or action lists) and whether members may review, correct or approve them. Examine specified circulation deadlines and procedures for resolving disagreements over the record. Distinguish member-validated documentation from staff-only summaries."
    },
    {
      "id": "G5-02",
      "area": "G5",
      "name": "Public information, meeting openness and stated origins",
      "description": "Assess whether the TOR identifies the committee's stated origins and mandate, including references to community advocacy or Council direction, and sets out public access to agendas, records, recommendations or meeting observation."
    },
    {
      "id": "G5-03",
      "area": "G5",
      "name": "Written accountability for committee recommendations",
      "description": "Assess whether the TOR requires staff to provide a written account of how committee recommendations were incorporated, which were not adopted, and the reasons for non-adoption. Check whether the TOR specifies the recipients and timing of that explanation. Distinguish a required response with reasons from general commitments to consider input or summarize engagement."
    },
    {
      "id": "G4-01",
      "area": "G4",
      "name": "Member authority over TOR rules and shared leadership",
      "description": "Assess who the TOR says may draft, approve and amend committee rules, and whether members share leadership through endorsement, joint approval, co-chairing or defined consultation. Distinguish member authority or agreed procedures from staff-only changes or leadership. Rate only the powers and procedures expressly described in the TOR; do not infer how leadership or amendments operated in practice."
    },
    {
      "id": "G4-02",
      "area": "G4",
      "name": "Accountable leadership and City staff obligations",
      "description": "Assess whether the TOR identifies who manages the committee, the responsible City division or partner, an accessible contact, and specific duties for staff or facilitators. Consider written commitments concerning meeting preparation, understandable information, relevant expertise, record keeping and follow-up. Distinguish named roles and clear obligations from general statements of responsibility."
    },
    {
      "id": "G4-03",
      "area": "G4",
      "name": "Alignment with members' democratic rights",
      "description": "Assess the TOR's provisions for members to express views, dissent, advocate independently, speak publicly and participate in other democratic processes. Examine written media, confidentiality, conduct, conflict-of-interest and membership-removal rules for restrictions, procedural safeguards and staff discretion. Distinguish explicit protection of members' rights from rules that limit independent civic activity. Judge only what the TOR permits or restricts, not whether members were actually censored, removed or discouraged."
    }
  ],
