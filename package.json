{
  "name": "little-jamaica-sac-tor-comparison",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent Little Jamaica SAC Terms of Reference comparison and community priority survey",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node server/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:assessment": "node scripts/validate-assessment.mjs data/assessment.json",
    "validate:publication": "node scripts/validate-assessment.mjs data/assessment.json --publish",
    "build": "node scripts/build.mjs"
  }
}
